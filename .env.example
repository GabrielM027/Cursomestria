# =============================================================================
# CURSO MESTRIA - Variáveis de Ambiente
# =============================================================================
# Copie este arquivo para .env e preencha com suas credenciais

# -----------------------------------------------------------------------------
# FRONTEND (público - prefixo VITE_)
# Estas variáveis são expostas no código do frontend
# -----------------------------------------------------------------------------

# URL do projeto Supabase
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública do Supabase (anon key)
VITE_SUPABASE_ANON_KEY=sua_anon_key_aqui

# -----------------------------------------------------------------------------
# BACKEND (secreto - apenas Vercel/servidor)
# NUNCA use prefixo VITE_ para variáveis secretas!
# -----------------------------------------------------------------------------

# URL do Supabase (igual VITE_SUPABASE_URL, mas para backend)
SUPABASE_URL=https://seu-projeto.supabase.co

# Chave de serviço do Supabase (service_role key)
# NUNCA exponha esta chave no frontend!
SUPABASE_SERVICE_ROLE_KEY=sua_service_role_key_aqui

# Token de acesso do Mercado Pago
# NUNCA exponha este token no frontend!
MERCADOPAGO_ACCESS_TOKEN=APP_USR-seu-access-token

# Email do administrador (recebe role 'admin' automaticamente)
ADMIN_EMAIL=seu-email@exemplo.com

# URL da aplicação (sem barra no final)
# Desenvolvimento: http://localhost:5173
# Produção: https://seu-app.vercel.app
APP_URL=http://localhost:5173

# Preço do curso em reais (sem símbolo)
COURSE_PRICE=197

# Título do curso (opcional)
COURSE_TITLE=Curso Mestria - Acesso 1 Ano
